{
  "name": "crown-of-ages",
  "version": "0.1.0",
  "private": true,
  "description": "Crown of Ages — RTS de navegador fiel em mecanicas ao Age of Empires IV, com arte/audio/nome originais.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name crown-of-ages --commit-dirty=true"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.10.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
